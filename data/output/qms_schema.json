          "$ref": "#/$defs/QMSField"
        },
        "domiciliary_hospitalization": {
          "$ref": "#/$defs/QMSField"
        },
        "annual_health_checkup": {
          "$ref": "#/$defs/QMSField"
        },
        "modern_treatment": {
          "$ref": "#/$defs/QMSField"
        },
        "bariatric_treatment": {
          "$ref": "#/$defs/QMSField"
        },
        "psychiatric_treatment": {
          "$ref": "#/$defs/QMSField"
        },
        "ayush_treatment": {
          "$ref": "#/$defs/QMSField"
        },
        "lgbtq_coverage": {
