    },
    "DetectionEvidence": {
      "description": "Why a detector reached its conclusion. Makes detection auditable.",
      "properties": {
        "signal": {
          "title": "Signal",
          "type": "string"
        },
        "matched_text": {
          "title": "Matched Text",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "weight": {
          "default": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "signal",
        "matched_text"
      ],
      "title": "DetectionEvidence",
      "type": "object"
    },
    "DocumentMeta": {
      "properties": {
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "file_sha256": {
          "title": "File Sha256",
          "type": "string"
        },
        "page_count": {
          "title": "Page Count",
          "type": "integer"
        },
        "ocr_pages": {
          "items": {
            "type": "integer"
          },
          "title": "Ocr Pages",
          "type": "array"
        },
        "characters_extracted": {
          "default": 0,
          "title": "Characters Extracted",
          "type": "integer"
        },
        "has_text_layer": {
          "default": true,
          "title": "Has Text Layer",
          "type": "boolean"
        }
      },
      "required": [
        "file_name",
        "file_sha256",
        "page_count"
      ],
      "title": "DocumentMeta",
      "type": "object"
    },
    "ExtractionMeta": {
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "pipeline_version": {
          "default": "1.0.0",
          "title": "Pipeline Version",
          "type": "string"
        },
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "mode": {
          "default": "rule_only",
          "title": "Mode",
          "type": "string"
        },
        "llm_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Provider"
        },
        "llm_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Model"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "fields_total": {
          "default": 0,
          "title": "Fields Total",
          "type": "integer"
        },
        "fields_populated": {
          "default": 0,
          "title": "Fields Populated",
          "type": "integer"
        },
        "coverage_pct": {
          "default": 0.0,
          "title": "Coverage Pct",
          "type": "number"
        },
        "confidence_breakdown": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Confidence Breakdown",
          "type": "object"
        },
        "fields_needing_review": {
          "items": {
            "type": "string"
          },
          "title": "Fields Needing Review",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "ExtractionMeta",
      "type": "object"
    },
    "ExtractionSource": {
      "enum": [
        "rule",
        "llm",
        "rule+llm",
        "derived",
        "none"
      ],
      "title": "ExtractionSource",
      "type": "string"
    },
    "FamilyStructure": {
      "properties": {
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        },
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display"
        },
        "employee": {
          "default": false,
          "title": "Employee",
          "type": "boolean"
        },
        "spouse": {
          "default": false,
          "title": "Spouse",
          "type": "boolean"
        },
        "children": {
          "default": false,
          "title": "Children",
          "type": "boolean"
        },
        "parents": {
          "default": false,
          "title": "Parents",
          "type": "boolean"
        },
        "parents_in_law": {
          "default": false,
          "title": "Parents In Law",
          "type": "boolean"
        },
        "max_children": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Children"
        },
        "cover_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cover Type"
        },
        "source": {
          "$ref": "#/$defs/ExtractionSource",
          "default": "none"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "low"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "FamilyStructure",
      "type": "object"
    },
    "FieldStatus": {
      "description": "Coverage verdict for a single QMS field.",
      "enum": [
        "covered",
        "not_covered",
        "waived_off",
        "applied",
        "present",
        "not_specified",
        "not_found",
        "not_applicable"
      ],
      "title": "FieldStatus",
      "type": "string"
    },
    "InfertilityAndAmbulance": {
      "properties": {
        "infertility_treatment": {
          "$ref": "#/$defs/QMSField"
        },
