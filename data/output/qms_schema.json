    "PolicyDetails": {
      "properties": {
        "policy_number": {
          "$ref": "#/$defs/QMSField"
        },
        "policyholder_name": {
          "$ref": "#/$defs/QMSField"
        },
        "product_name": {
          "$ref": "#/$defs/QMSField"
        },
        "product_type": {
          "$ref": "#/$defs/ProductType",
          "default": "unknown"
        },
        "previous_year_policy_period": {
          "$ref": "#/$defs/PolicyPeriod"
        },
        "previous_year_premium": {
          "$ref": "#/$defs/PremiumDetails"
        }
      },
      "title": "PolicyDetails",
      "type": "object"
    },
    "PolicyPeriod": {
      "description": "The policy period stated on the document.\n\nAssumption (documented in README): the sample documents are the *expiring* policies\nbeing renewed, so the period printed on them is the \"previous year\" period the QMS\nasks for.",
      "properties": {
        "inception_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inception Date"
        },
        "expiry_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiry Date"
        },
        "inception_date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inception Date Raw"
        },
        "expiry_date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiry Date Raw"
        },
        "tenure_display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenure Display"
        },
        "tenure_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenure Days"
        },
        "tenure_months": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenure Months"
        },
        "first_policy_inception_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Policy Inception Date"
        },
        "source": {
          "$ref": "#/$defs/ExtractionSource",
          "default": "none"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "low"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "title": "PolicyPeriod",
      "type": "object"
    },
    "PolicyStructure": {
      "properties": {
        "family_structure": {
          "$ref": "#/$defs/FamilyStructure"
        },
        "sum_insured_tiers": {
          "items": {
            "type": "number"
          },
          "title": "Sum Insured Tiers",
          "type": "array"
        },
        "sum_insured_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sum Insured Basis"
        },
        "aggregate_sum_insured": {
          "$ref": "#/$defs/QMSField"
        },
        "sum_insured_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sum Insured Evidence"
        },
        "sum_insured_page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sum Insured Page"
        },
        "sum_insured_source": {
          "$ref": "#/$defs/ExtractionSource",
          "default": "none"
        }
      },
      "title": "PolicyStructure",
      "type": "object"
    },
    "PremiumDetails": {
      "properties": {
        "net_premium": {
          "$ref": "#/$defs/QMSField"
        },
        "gross_premium": {
          "$ref": "#/$defs/QMSField"
        },
        "tax_amount": {
          "$ref": "#/$defs/QMSField"
        },
        "payment_mode": {
          "$ref": "#/$defs/QMSField"
        }
      },
      "title": "PremiumDetails",
      "type": "object"
    },
    "ProductType": {
      "description": "Product classification. Drives which benefit groups are applicable.",
      "enum": [
        "group_medical_cover",
        "group_personal_accident",
        "group_term_life",
        "group_opd",
        "unknown"
      ],
      "title": "ProductType",
      "type": "string"
    },
    "QMSField": {
      "description": "One QMS cell, carrying both a machine value and the human evidence behind it.\n\n``value`` + ``unit`` + ``basis`` is what the QMS consumes; ``raw_text`` + ``page`` is\nwhat a human auditor checks. Emitting only one of the two would make the output either\nunverifiable or unusable.",
      "properties": {
        "status": {
          "$ref": "#/$defs/FieldStatus",
          "default": "not_found"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueUnit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display"
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "source": {
          "$ref": "#/$defs/ExtractionSource",
          "default": "none"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "low"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "alternate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternate"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "QMSField",
      "type": "object"
    },
    "RoomAndHospitalisation": {
      "properties": {
        "room_rent": {
          "$ref": "#/$defs/QMSField"
        },
        "icu_charges": {
          "$ref": "#/$defs/QMSField"
        },
        "pre_hospitalization": {
          "$ref": "#/$defs/QMSField"
        },
        "post_hospitalization": {
          "$ref": "#/$defs/QMSField"
        },
        "room_rent_proportionate_deduction": {
          "$ref": "#/$defs/QMSField"
        }
      },
      "title": "RoomAndHospitalisation",
      "type": "object"
    },
    "TPADetection": {
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "mode": {
          "$ref": "#/$defs/TPAMode",
          "default": "unknown"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "low"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/DetectionEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "title": "TPADetection",
      "type": "object"
    },
    "TPAMode": {
      "enum": [
        "external_tpa",
        "in_house_insurer_administered",
        "unknown"
      ],
      "title": "TPAMode",
      "type": "string"
    },
    "ValueUnit": {
      "description": "Unit attached to :attr:`QMSField.value`, so the number is machine-interpretable.",
      "enum": [
        "INR",
        "percent_of_sum_insured",
        "percent",
        "days",
        "months",
        "years",
        "count",
        "text"
      ],
      "title": "ValueUnit",
      "type": "string"
    },
    "WaitingPeriods": {
      "properties": {
        "thirty_day_waiting_period": {
          "$ref": "#/$defs/QMSField"
        },
        "first_and_second_year_waiting_period": {
          "$ref": "#/$defs/QMSField"
        },
        "pre_existing_diseases": {
          "$ref": "#/$defs/QMSField"
        }
      },
      "title": "WaitingPeriods",
      "type": "object"
    }
  },
  "description": "One policy document, mapped into the QMS schema.",
  "properties": {
    "document": {
      "$ref": "#/$defs/DocumentMeta"
