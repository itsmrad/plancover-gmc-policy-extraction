        },
        "irdai_registration_no": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Irdai Registration No"
        },
        "cin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cin"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "low"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/DetectionEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "runner_up": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runner Up"
        }
      },
      "title": "InsurerDetection",
      "type": "object"
    },
    "Maternity": {
      "properties": {
        "nine_month_waiting_period": {
          "$ref": "#/$defs/QMSField"
        },
        "baby_day_one_cover": {
          "$ref": "#/$defs/QMSField"
        },
        "vaccination_cover": {
