        }
      },
      "title": "BufferAndWaivers",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Demographics": {
      "properties": {
        "employees": {
          "$ref": "#/$defs/QMSField"
        },
        "spouses": {
          "$ref": "#/$defs/QMSField"
        },
