# ---------------------------------------------------------------------------
# LLM layer configuration (OPTIONAL)
#
# The pipeline runs fully without any of these: it falls back to the
# deterministic rule extractor and reports source="rule" on every field.
# Setting a key switches on the second, generalising extractor and enables
# rule-vs-LLM cross-validation (source="rule+llm", higher confidence).
# ---------------------------------------------------------------------------

# One of: none | openai | gemini | anthropic | ollama
GMC_LLM_PROVIDER=none

# --- openai (or any OpenAI-compatible endpoint: Groq, Together, OpenRouter, vLLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- ollama (fully local, no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
